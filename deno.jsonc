{
  // Centralised dependency versions for main.ts. Transitive versions are
  // pinned in deno.lock so builds are reproducible.
  "imports": {
    "@std/http": "jsr:@std/http@^1.1.3"
  },

  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env main.ts",
    "check": "deno check main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "node --test test/action.test.js && deno test --allow-env --allow-read test/*_test.ts"
  },

  "fmt": {
    "include": [
      "main.ts",
      "github.ts",
      "test/github_test.ts",
      "test/static_test.ts",
      "deno.jsonc"
    ]
  },

  "lint": {
    "include": ["main.ts", "github.ts"],
    "rules": {
      "tags": ["recommended"]
    }
  }
}
