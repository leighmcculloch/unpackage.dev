{
  // Centralised dependency versions for main.ts. Transitive versions are
  // pinned in deno.lock so builds are reproducible.
  "imports": {
    "@std/http": "jsr:@std/http@^1.0.0"
  },

  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env main.ts",
    "check": "deno check main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "test": "node --test test/action.test.js"
  },

  "fmt": {
    "include": ["main.ts", "deno.jsonc"]
  },

  "lint": {
    "include": ["main.ts"],
    "rules": {
      "tags": ["recommended"]
    }
  }
}
